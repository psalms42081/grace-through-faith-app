{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "expo:dev": "node scripts/kill-port.js 8081 && CI=1 EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost --port 8081",
    "server:dev": "node scripts/kill-port.js 5000 && NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=cjs --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "db:migrate:numbered": "tsx scripts/run-numbered-migrations.ts",
    "db:prepare-devotional-catalog": "tsx scripts/prepare-devotional-catalog.ts",
    "test:deploy-build-safety": "node scripts/test-deploy-build-safety.mjs",
    "test:numbered-migrations": "bash scripts/test-numbered-migrations.sh",
    "test:devotional-catalog": "node server/tests/devotional-catalog-health.test.mjs",
    "test:devotional-catalog-coordinator": "tsx server/tests/devotional-catalog-coordinator.test.ts",
    "test:devotional-authorship": "npm run test:devotional-catalog && npm run test:devotional-catalog-coordinator && node server/tests/devotional-authorship.test.mjs && npm run test:devotional-authorship-api",
    "test:devotional-authorship-api": "tsx server/tests/devotional-authorship-api.test.ts",
    "test:kids-story-illustrations": "tsx tests/kids-story-scene-illustration-request.test.ts && tsx server/tests/kids-scene-image-in-flight.test.ts",
    "test:verse-map-generation": "tsx tests/verse-map-generation.test.ts",
    "start": "npx expo start",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-with-warning-budget.mjs",
    "lint:report": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "check": "npm run typecheck && npm run lint && npm run test:deploy-build-safety"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
