DATABASE_URL=postgresql://user:password@host:5432/dbname
EXPO_PUBLIC_DOMAIN=your-local-ip:5000
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

# Optional
# OpenAI (preferred names)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# Legacy Replit aliases still work as fallback:
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# ELEVENLABS_API_KEY=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=

# Feedback email (SMTP credentials)
# FEEDBACK_EMAIL_USER=
# FEEDBACK_EMAIL_PASS=

# Google Cloud Translation API (for multilingual content - 130+ languages)
# GOOGLE_TRANSLATE_API_KEY=

# Set to "true" to run database seeds on startup
# RUN_STARTUP_SEEDS=false

# Set to "true" only in development to allow insecure password reset
# ALLOW_INSECURE_PASSWORD_RESET=false
