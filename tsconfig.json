{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "artifacts/**",
    "comparison-deck/**",
    "dist/**",
    "server_dist/**",
    "server/tests/**",
    "**/.generated/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
