# Loaded by Expo whenever the bundler runs in production mode: `eas update`, `eas build`,
# `expo export`, and `expo export:embed --dev false`. It wins over `.env`, so an OTA update
# always points the native app at the live API without an EXPO_PUBLIC_DOMAIN shell override.
# `expo start` runs in development mode and keeps using `.env`. No secrets belong here.
EXPO_PUBLIC_DOMAIN=informedministries.app
