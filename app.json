{
  "expo": {
    "name": "Informed Ministries",
    "slug": "grace-through-faith",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/informed-ministries-icon.png",
    "scheme": "graceThroughFaith",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/informed-ministries-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1F3C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.graceThroughFaith",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "package": "com.graceThroughFaith",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1A1F3C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "assets": [
      "./assets/fonts/Ionicons.ttf"
    ],
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Ionicons.ttf"
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "android": {
            "image": "./assets/images/android-icon-foreground.png",
            "backgroundColor": "#1A1F3C",
            "iconBackgroundColor": "#1A1F3C",
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-notification-icon.png",
          "color": "#1A1F3C",
          "defaultChannel": "daily-reminders",
          "sounds": [],
          "mode": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Informed Ministries to use your location to find nearby churches.",
          "locationWhenInUsePermission": "Allow Informed Ministries to use your location to find nearby churches."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Informed Ministries to use your camera for live fellowship video.",
          "microphonePermission": "Allow Informed Ministries to use your microphone for live fellowship audio."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
