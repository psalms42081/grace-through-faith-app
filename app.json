{
  "expo": {
    "name": "Informed Ministries",
    "slug": "grace-through-faith",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/informed-ministries-icon.png",
    "scheme": "informedministries",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/informed-ministries-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1F3C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.graceThroughFaith",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "package": "com.informedministries.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1A1F3C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "d9393f6d-a589-44e4-8359-04953488bb01"
      },
      "router": {
        "origin": "https://informedministries.app"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Informed Ministries",
      "shortName": "Informed",
      "themeColor": "#FBF7EE",
      "backgroundColor": "#FBF7EE",
      "display": "standalone",
      "startUrl": "/",
      "lang": "en"
    },
    "assets": [
      "./assets/fonts/Ionicons.ttf"
    ],
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://informedministries.app"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Ionicons.ttf"
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "android": {
            "image": "./assets/images/android-icon-foreground.png",
            "backgroundColor": "#1A1F3C",
            "iconBackgroundColor": "#1A1F3C",
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-notification-icon.png",
          "color": "#1A1F3C",
          "defaultChannel": "daily-reminders",
          "sounds": [],
          "mode": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Informed Ministries to use your location to find nearby churches.",
          "locationWhenInUsePermission": "Allow Informed Ministries to use your location to find nearby churches."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Informed Ministries to use your camera for live fellowship video.",
          "microphonePermission": "Allow Informed Ministries to use your microphone for live fellowship audio."
        }
      ],
      "expo-audio",
      "expo-image",
      "expo-localization",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "informed-ministries"
  }
}
